*.py[cod]
.pytest_cache
.ruff_cache
.coverage
htmlcov
tests
tools
bots
docs
scripts
client/recordings
client/viewer.html
client/viewer.js
client/recording.js
client/README.md
*.md
.gitignore
ruff.toml
